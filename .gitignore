.env
.env.local
.env.*
!.env.example

# --- 機密與資料庫備份（絕對不可進版控）---
# backup 服務每 5 分鐘輸出的即時備份，內含 admins 密碼雜湊與 contacts 客戶個資
# 用 /* 而非 / 結尾，才能用 ! 保留 .gitkeep（父目錄被排除時無法再 included 子檔）
mysql/backup/*
!mysql/backup/.gitkeep
mysql/init/05-latest-backup.sql
mysql/**/*backup*.sql
*.sql.bak
mysqldump/
# review H7：日期檔名的備份。mysql/backup/* 已涵蓋 sql.gz，
# 但 uploads 封存（tar.gz）與校驗值分別在 backups/ 與 backups/checksums/ 下，需獨立規則。
handsoap-*.sql.gz
handsoap-uploads-*.tar.gz

# --- 本地環境覆寫 ---
# 注意：application.properties 是 Spring Boot 的唯一設定檔，必須進版控，
#       裡面只准寫 ${ENV_VAR} 引用，不准寫機密預設值。機密放這裡或 .env。
application-local.properties
application-*.local.yml

node_modules/
dist/
build/
target/
uploads/*
!uploads/.gitkeep
# 審計日誌（review H5）：應用日誌落地目錄，內容屬營運資料不進版控。
# 與 uploads/ 同理排除內容但保留 .gitkeep，否則目錄不存在時
# docker 的 volume 掛載會以 root 身分建立，容器內非 root 用戶將無法寫入。
logs/*
!logs/.gitkeep
.mysql-data/
backups/*
!backups/.gitkeep
# review H7：校驗值放在獨立目錄，但仍屬營運資料，不進版控。
# 必須讓父目錄能被 included，否則整個 backups/checksums/ 會消失、
# 新 clone 後目錄不存在，docker 的 volume 掛載會以 root 建立（容器內非 root 用戶無法寫入）。
!backups/checksums/
backups/checksums/*
!backups/checksums/.gitkeep
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.codegraph
.kilo

# --- 建置產物與快取 ---
.angular/
out-tsc/
coverage/
/backend/app.jar
backend/*.jar

