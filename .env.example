# 複製為 .env 後填入真實值：cp .env.example .env
# .env 已被 .gitignore 排除，絕對不要提交。

# ---- docker compose 讀取（docker-compose.yml 以 ${...} 取代）----
DB_ROOT_PASS=your_secure_root_password
DB_USER=handsoap_user
DB_PASS=your_secure_password
# HS256 需要至少 256 bits（32 位元組）隨機金鑰，產生方式：
#   openssl rand -base64 48
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 64 | %{[char]$_})
JWT_SECRET=your_very_long_and_random_jwt_secret_key_here_at_least_256_bits

# ---- CORS 白名單（review H4）----
# 後端只接受這些來源發來的跨站請求；其他來源一律 403。
# 生產請填實際網域（前端與 API 同網域時其實可留空 —— 同源請求不走 CORS 檢查）。
#
# 注意：
#   1. 不可填 *。含 * 時後端會直接啟動失敗（fail-fast），避免 H4 被無聲繞過。
#   2. 多個來源以「逗號」分隔。
#   3. 本機用 ng serve 預設是 http://localhost:4200，application.properties 已有預設值。
#      若用其他埠或用手機在同網域測試，請把該來源一併加入，例如：
#      CORS_ALLOWED_ORIGINS=http://localhost:4200,http://192.168.1.10:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- 本機直接跑 Spring Boot 時讀取的名稱（application.properties 用這些）----
# 注意：compose 把 MySQL 對應到本機 3307 埠，不是 3306
DATABASE_URL=jdbc:mysql://localhost:3307/handsoap?useSSL=false&serverTimezone=Asia/Taipei&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DATABASE_USERNAME=handsoap_user
DATABASE_PASSWORD=your_secure_password
# 可選：none / update / validate。正式與容器都用 none（schema 由 mysql/init/01-schema.sql 建立）
HIBERNATE_DDL=none

# ---- 首位後台管理員（bootstrap）----
# 安全性說明：早期版本是「admins 表為空時，任何人都能匿名呼叫
# POST /api/v1/admin/admins 建立第一個管理員」，等於把部署後到 owner
# 建立帳號前的時間窗開放給公網，任何人都能搶先建立 ADMIN 接管後台。
# 現在該端點已全面要求 ADMIN 權限，首位管理員改由後端啟動時建立。
#
# 使用方式（只需做一次）：
#   1. 在 .env 填入下面三個變數，並把 BOOTSTRAP_ENABLED 設為 true
#   2. docker compose up -d backend（啟動時會自動建立管理員）
#   3. 登入後台並立即更換密碼
#   4. 把 BOOTSTRAP_ENABLED 改回 false，避免日後重啟時重複處理
#
# 注意：若本機 mysql/backup/ 有備份檔，05-restore-seed.sh 會先還原既有管理員，
# 此時後端會自動跳過 bootstrap（不會覆蓋既有帳號），可直接跳過第 2、3 步。
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_this_to_a_strong_password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---- 登入限流（review H5）----
# 後端對登入失敗採「指數退避」：超過門檻後，每次失敗的等待時間倍增
# （30秒 → 1分 → 2分 → … → 30分封頂），成功登入立即清空計數。
#
# 不採用「N 次鎖 M 分鐘」的硬鎖定：那會讓攻擊者只要知道帳號名（預設 admin）
# 打幾次就能把後台鎖到無法登入，是把弱密碼風險換成後台永久鎖死風險。
#
# username 門檻刻意比 IP 嚴格：IP 常是公司／CGNAT 的共用出口，門檻太高會誤傷真人。
# 注意：這兩個計數存在記憶體中，重啟後清零；目前 docker-compose 是單一 backend 實例，
# 若日後擴充成多實例，必須改用 Redis，否則實際門檻會變成 N 倍而形同虛設。
LOGIN_USERNAME_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
